# rag_service/.env.mac
# Apple Silicon Mac 로컬 개발 전용 환경변수
# docker-compose.mac.yml 과 함께 사용
APP_ENV=development
RERANKER_ENABLED=true
HYBRID_ALPHA=0.5
WATCH_FOLDER=
SEMANTIC_CHUNKER_THRESHOLD=0.85

DATABASE_URL=postgresql+asyncpg://raguser:ragpass@db:5432/ragdb

EMBEDDING_BACKEND=ollama
EMBEDDING_DIMENSIONS=1024
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large

# ollama: Mac 로컬 Ollama 연결 (host.docker.internal)
# mlx   : Apple Silicon 내장 추론 (Ollama 불필요)
LLM_BACKEND=ollama

VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
VLLM_API_KEY=EMPTY
HF_TOKEN=

MLX_MODEL=mlx-community/Qwen2.5-7B-Instruct-4bit
MLX_MAX_TOKENS=32

# host.docker.internal → Mac 로컬 Ollama (ollama serve 실행 상태 필요)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e4b-it-q4_K_M
OLLAMA_API_KEY=ollama
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
