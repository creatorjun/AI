# rag_service/.env.example
DATABASE_URL=postgresql+asyncpg://raguser:ragpass@db:5432/ragdb

# 임베딩 백엔드: openai | ollama
# openai  — OpenAI text-embedding-3-large (OPENAI_API_KEY 필수)
# ollama  — 완전 로컬 임베딩 (API 키 불필요)
EMBEDDING_BACKEND=ollama
EMBEDDING_DIMENSIONS=1024

# OpenAI 설정 (EMBEDDING_BACKEND=openai 시 필수)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large

# LLM 백엔드: vllm | mlx | ollama
# vllm   — NVIDIA GPU 서버 (CC 8.0+, VRAM 8GB+)
# mlx    — Apple Silicon Mac (M1/M2/M3/M4)
# ollama — NVIDIA GTX/RTX (VRAM 4GB+, CPU 오프로드 지원)
LLM_BACKEND=ollama

# vLLM 설정 (LLM_BACKEND=vllm)
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_API_KEY=EMPTY

# MLX 설정 (LLM_BACKEND=mlx, Apple Silicon 전용)
MLX_MODEL=mlx-community/Qwen2.5-7B-Instruct-4bit
MLX_MAX_TOKENS=32

# Ollama 설정 (LLM_BACKEND=ollama 또는 EMBEDDING_BACKEND=ollama)
# GTX 1650 (4GB) 권장 모델 조합
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma4:e4b-it-q4_K_M
OLLAMA_API_KEY=ollama
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large

HF_TOKEN=
APP_ENV=development
RERANKER_ENABLED=true
HYBRID_ALPHA=0.5
WATCH_FOLDER=
SEMANTIC_CHUNKER_THRESHOLD=0.85
