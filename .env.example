# rag_service/.env.example
DATABASE_URL=postgresql+asyncpg://raguser:ragpass@db:5432/ragdb
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# LLM 백엔드 선택: vllm | mlx | ollama
# vllm  — NVIDIA GPU 서버 (Compute Capability 8.0+, VRAM 8GB+)
# mlx   — Apple Silicon Mac (M1/M2/M3/M4)
# ollama — NVIDIA GTX/RTX (VRAM 4GB+, CPU 오프로드 지원)
LLM_BACKEND=ollama

# ── vLLM 설정 (LLM_BACKEND=vllm) ─────────────────────────────
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_API_KEY=EMPTY

# ── MLX 설정 (LLM_BACKEND=mlx, Apple Silicon 전용) ───────────
MLX_MODEL=mlx-community/Qwen2.5-7B-Instruct-4bit
MLX_MAX_TOKENS=32

# ── Ollama 설정 (LLM_BACKEND=ollama) ─────────────────────────
# GTX 1650 (4GB) 환경 권장 모델: gemma4:e4b-it-q4_K_M
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=gemma4:e4b-it-q4_K_M
OLLAMA_API_KEY=ollama

HF_TOKEN=
APP_ENV=development
RERANKER_ENABLED=true
HYBRID_ALPHA=0.5
WATCH_FOLDER=
SEMANTIC_CHUNKER_THRESHOLD=0.85
