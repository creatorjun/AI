# rag_service/.env.example
# =====================================================================
# 공통 설정
# =====================================================================
APP_ENV=development
RERANKER_ENABLED=true
HYBRID_ALPHA=0.5
WATCH_FOLDER=
SEMANTIC_CHUNKER_THRESHOLD=0.85

# =====================================================================
# 데이터베이스
# docker compose 기동 시 : postgresql+asyncpg://raguser:ragpass@db:5432/ragdb
# 로컬 직접 실행 시      : postgresql+asyncpg://raguser:ragpass@localhost:5432/ragdb
# =====================================================================
DATABASE_URL=postgresql+asyncpg://raguser:ragpass@db:5432/ragdb

# =====================================================================
# 임베딩 백엔드: openai | ollama
# openai  — OpenAI text-embedding-3-large (OPENAI_API_KEY 필수)
# ollama  — 완전 로컬 임베딩 (API 키 불필요)
# =====================================================================
EMBEDDING_BACKEND=ollama
EMBEDDING_DIMENSIONS=1024
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large

# =====================================================================
# LLM 백엔드: vllm | mlx | ollama
#
# [vllm]   NVIDIA GPU 서버 (CC 8.0+, VRAM 8GB+)
#          프로파일: gpu       → docker compose --profile gpu up
#          프로파일: vllm-cpu  → docker compose --profile vllm-cpu up  (CPU 전용)
#
# [ollama] NVIDIA GTX/RTX (VRAM 4GB+) 또는 CPU 전용
#          프로파일: ollama     → docker compose --profile ollama up
#          프로파일: ollama-cpu → docker compose --profile ollama-cpu up
#          Mac 로컬 Ollama     → docker compose -f docker-compose.yml -f docker-compose.mac.yml up
#
# [mlx]   Apple Silicon Mac (M1/M2/M3/M4) 전용 — 별도 서버 불필요
#          docker compose -f docker-compose.yml -f docker-compose.mac.yml up
# =====================================================================
LLM_BACKEND=ollama

# vLLM 설정 (LLM_BACKEND=vllm)
# docker compose 기동 시 : http://vllm:8000/v1
# vllm-cpu 프로파일      : http://vllm-cpu:8000/v1
# 로컬 직접 실행 시      : http://localhost:8001/v1
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_API_KEY=EMPTY
HF_TOKEN=

# MLX 설정 (LLM_BACKEND=mlx, Apple Silicon 전용)
MLX_MODEL=mlx-community/Qwen2.5-7B-Instruct-4bit
MLX_MAX_TOKENS=32

# Ollama 설정 (LLM_BACKEND=ollama 또는 EMBEDDING_BACKEND=ollama)
# docker compose 기동 시            : http://ollama:11434
# ollama-cpu 프로파일               : http://ollama-cpu:11434
# Mac 로컬 Ollama (docker-compose.mac.yml 사용 시) : http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma4:e4b-it-q4_K_M
OLLAMA_API_KEY=ollama
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
